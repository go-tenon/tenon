package note

import (
	"time"

	"github.com/ryan053857/go-kit/starter/components/button"
	"github.com/ryan053857/go-kit/starter/components/card"
	"github.com/ryan053857/go-kit/starter/components/input"
)

templ notesContent(notes []Note) {
	<div class="flex flex-col gap-6">
		<div class="flex items-center gap-2">
			<h1 class="mr-auto text-2xl font-semibold">我的笔记</h1>
			@button.Button(button.Props{Href: "/notes/export?format=csv", Variant: button.VariantOutline, Size: button.SizeSm}) {
				导出 CSV
			}
			@button.Button(button.Props{Href: "/notes/export?format=xlsx", Variant: button.VariantOutline, Size: button.SizeSm}) {
				导出 Excel
			}
			@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeSm,
				Attributes: templ.Attributes{"hx-post": "/notes/export-jobs", "hx-vals": `{"format":"xlsx"}`, "hx-swap": "none"}}) {
				后台导出
			}
		</div>
		<form
			class="flex gap-2"
			hx-post="/notes"
			hx-target="#notes"
			hx-swap="afterbegin"
			hx-on::after-request="if (event.detail.successful && event.detail.target.id === 'notes') this.reset()"
		>
			@input.Input(input.Props{Name: "text", Placeholder: "写点什么…", Attributes: templ.Attributes{"autocomplete": "off"}})
			@button.Button(button.Props{Type: button.TypeSubmit}) {
				添加
			}
		</form>
		<ul id="notes" class="flex flex-col gap-2">
			for i := range notes {
				@noteItem(&notes[i])
			}
		</ul>
	</div>
}

templ noteItem(n *Note) {
	<li>
		<a href={ templ.SafeURL("/notes/" + n.ID.String()) } class="block">
			@card.Card(card.Props{Class: "hover:bg-accent/50 py-4 transition-colors"}) {
				@card.Content(card.ContentProps{Class: "flex items-center justify-between gap-4"}) {
					<span class="truncate">{ n.Text }</span>
					<span class="text-muted-foreground shrink-0 text-xs">{ n.CreatedAt.In(time.Local).Format("01-02 15:04") }</span>
				}
			}
		</a>
	</li>
}
