package note

templ notesContent(notes []Note) {
	<h1>笔记</h1>
	<form hx-post="/notes" hx-target="#notes" hx-swap="beforeend" hx-on::after-request="if (event.detail.successful) this.reset()">
		<input name="text" placeholder="写点什么…" autocomplete="off"/>
		<button type="submit">添加</button>
	</form>
	<ul id="notes">
		for _, n := range notes {
			@noteItem(&n)
		}
	</ul>
	<button hx-get="/" hx-target="#content">刷新</button>
}

templ noteItem(n *Note) {
	<li><a href={ templ.SafeURL("/notes/" + n.ID.String()) }>{ n.Text }</a> <small>— { n.Author }</small></li>
}
