package pages

import (
	"time"

	"github.com/ryan053857/go-kit/modules/account"
	"github.com/ryan053857/go-kit/starter/components/alert"
	"github.com/ryan053857/go-kit/starter/components/badge"
	"github.com/ryan053857/go-kit/starter/components/button"
	"github.com/ryan053857/go-kit/starter/components/card"
	"github.com/ryan053857/go-kit/starter/components/field"
	"github.com/ryan053857/go-kit/starter/components/input"
	"github.com/ryan053857/go-kit/starter/components/table"
	"github.com/ryan053857/go-kit/starter/views"
)

// textField 是带标签的输入框。
templ textField(id, label, name, typ, value, autocomplete string) {
	@field.Field() {
		@field.Label(field.LabelProps{For: id}) {
			{ label }
		}
		@input.Input(input.Props{ID: id, Name: name, Type: typ, Value: value, Required: true,
			Attributes: templ.Attributes{"autocomplete": autocomplete}})
	}
}

templ formError(msg string) {
	if msg != "" {
		@alert.Alert(alert.Props{Variant: alert.VariantDestructive}) {
			@alert.Description() {
				{ msg }
			}
		}
	}
}

templ submit(label string) {
	@button.Button(button.Props{Type: button.TypeSubmit, Class: "w-full"}) {
		{ label }
	}
}

templ loginPage(f form) {
	@views.AuthCard("登录", "使用邮箱和密码登录") {
		<form method="post" action="/login" class="flex flex-col gap-6">
			<input type="hidden" name="next" value={ f.Next }/>
			@formError(f.Error)
			@field.Group() {
				@textField("email", "邮箱", "email", "email", f.Email, "email")
				@field.Field() {
					<div class="flex items-center">
						@field.Label(field.LabelProps{For: "password"}) {
							密码
						}
						<a href="/forgot-password" class="text-muted-foreground ml-auto text-sm underline-offset-4 hover:underline">忘记密码？</a>
					</div>
					@input.Input(input.Props{ID: "password", Name: "password", Type: "password", Required: true,
						Attributes: templ.Attributes{"autocomplete": "current-password"}})
				}
			}
			@submit("登录")
			<p class="text-muted-foreground text-center text-sm">
				还没有账号？<a href="/register" class="text-foreground underline underline-offset-4">注册</a>
			</p>
		</form>
	}
}

templ registerPage(f form) {
	@views.AuthCard("注册", "创建一个新账号") {
		<form method="post" action="/register" class="flex flex-col gap-6">
			@formError(f.Error)
			@field.Group() {
				@textField("name", "名称", "name", "text", f.Name, "name")
				@textField("email", "邮箱", "email", "email", f.Email, "email")
				@textField("password", "密码（至少 8 位）", "password", "password", "", "new-password")
			}
			@submit("注册")
			<p class="text-muted-foreground text-center text-sm">
				已有账号？<a href="/login" class="text-foreground underline underline-offset-4">登录</a>
			</p>
		</form>
	}
}

templ forgotPage(f form) {
	@views.AuthCard("找回密码", "输入注册邮箱，我们会发送重置密码的链接") {
		if f.Done {
			@alert.Alert() {
				@alert.Title() {
					请查收邮件
				}
				@alert.Description() {
					如果 { f.Email } 已注册，你会收到一封包含重置链接的邮件。
				}
			}
			@button.Button(button.Props{Href: "/login", Variant: button.VariantOutline, Class: "mt-6 w-full"}) {
				返回登录
			}
		} else {
			<form method="post" action="/forgot-password" class="flex flex-col gap-6">
				@field.Group() {
					@textField("email", "邮箱", "email", "email", f.Email, "email")
				}
				@submit("发送重置链接")
				<p class="text-muted-foreground text-center text-sm">
					<a href="/login" class="underline underline-offset-4">返回登录</a>
				</p>
			</form>
		}
	}
}

templ resetPage(f form) {
	@views.AuthCard("重置密码", "设置一个新密码") {
		<form method="post" action="/reset-password" class="flex flex-col gap-6">
			<input type="hidden" name="token" value={ f.Token }/>
			@formError(f.Error)
			@field.Group() {
				@textField("password", "新密码（至少 8 位）", "password", "password", "", "new-password")
			}
			@submit("重置密码")
		</form>
	}
}

templ settingsPage(d *settingsData) {
	<div class="flex flex-col gap-6">
		<h1 class="text-2xl font-semibold">账号设置</h1>
		@card.Card() {
			@card.Header() {
				@card.Title() {
					基本信息
				}
				@card.Description() {
					{ d.User.Email }
				}
			}
			@card.Content(card.ContentProps{Class: "flex flex-col gap-6"}) {
				<div class="flex items-center gap-4">
					@views.Avatar(d.AvatarURL, views.DisplayName(d.User), "size-16 text-lg")
					<form method="post" action="/settings/avatar" enctype="multipart/form-data" class="flex items-center gap-2">
						<input
							type="file"
							name="avatar"
							accept="image/jpeg,image/png,image/gif,image/webp"
							class="text-muted-foreground max-w-56 text-sm file:mr-2 file:rounded-md file:border-0 file:bg-secondary file:px-2 file:py-1 file:text-sm"
							onchange="this.form.requestSubmit()"
						/>
					</form>
					if d.AvatarURL != "" {
						<form method="post" action="/settings/avatar/remove">
							@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantGhost, Size: button.SizeSm}) {
								删除头像
							}
						</form>
					}
				</div>
				<form method="post" action="/settings/profile" class="flex items-end gap-3">
					<div class="flex-1">
						@textField("name", "名称", "name", "text", d.User.Name, "name")
					</div>
					@button.Button(button.Props{Type: button.TypeSubmit}) {
						保存
					}
				</form>
			}
		}
		@card.Card() {
			@card.Header() {
				@card.Title() {
					修改密码
				}
				@card.Description() {
					修改后其他设备会退出登录
				}
			}
			@card.Content() {
				<form method="post" action="/settings/password" class="flex flex-col gap-6">
					@formError(d.Error)
					@field.Group() {
						@textField("current_password", "当前密码", "current_password", "password", "", "current-password")
						@textField("new_password", "新密码（至少 8 位）", "new_password", "password", "", "new-password")
					}
					<div>
						@button.Button(button.Props{Type: button.TypeSubmit}) {
							修改密码
						}
					</div>
				</form>
			}
		}
		@card.Card() {
			@card.Header() {
				@card.Title() {
					登录设备
				}
				@card.Description() {
					网页与 App 的全部登录，可以让不认识的设备退出登录
				}
			}
			@card.Content() {
				@table.Table() {
					@table.Header() {
						@table.Row() {
							@table.Head() {
								设备
							}
							@table.Head() {
								IP
							}
							@table.Head() {
								最近活跃
							}
							@table.Head() {
							}
						}
					}
					@table.Body() {
						for _, s := range d.Sessions {
							@sessionRow(s, s.ID == d.Current)
						}
					}
				}
			}
		}
	</div>
}

templ sessionRow(s account.Session, current bool) {
	@table.Row() {
		@table.Cell(table.CellProps{Class: "max-w-72 truncate"}) {
			if s.Kind == account.KindWeb {
				@badge.Badge(badge.Props{Variant: badge.VariantSecondary, Class: "mr-2"}) {
					网页
				}
			} else {
				@badge.Badge(badge.Props{Variant: badge.VariantOutline, Class: "mr-2"}) {
					App
				}
			}
			<span title={ s.UserAgent }>{ s.UserAgent }</span>
		}
		@table.Cell() {
			{ s.IP }
		}
		@table.Cell() {
			{ s.LastSeenAt.In(time.Local).Format("2006-01-02 15:04") }
		}
		@table.Cell(table.CellProps{Class: "text-right"}) {
			if current {
				<span class="text-muted-foreground text-sm">当前设备</span>
			} else {
				@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeSm,
					Attributes: templ.Attributes{
						"hx-post":    "/settings/sessions/" + s.ID.String() + "/revoke",
						"hx-target":  "closest tr",
						"hx-swap":    "outerHTML",
						"hx-confirm": "确定让该设备退出登录？",
					}}) {
					退出登录
				}
			}
		}
	}
}
