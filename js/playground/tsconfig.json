{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node", "vite/client"],
    "paths": {
      "@go-tenon/ui": ["../ui/src/index.ts"],
      "@go-tenon/client": ["../client/src/index.ts"]
    }
  },
  "include": ["src", "*.ts"]
}
