# 应用级部署声明（提交到仓库，不含主机地址和密钥）：
# 各独立实例放在 deploy/targets/<name>/（整体加入 .gitignore），新增实例可复制 deploy/example。
app: [[.Slug]]
# 可选：GitHub 仓库（owner/repo），供 --tag 拉取 Release 产物；留空时从 git origin 自动推导
# repo: owner/[[.Slug]]
# 默认目标 Linux 架构（amd64、arm64）；留空时通过 SSH 自动探测
# arch: amd64
keep_releases: 5
[[- if .HasSSR]]
has_ssr: true
[[- end]]

# 所有部署实例继承的默认参数，可在各实例的 target.yaml 中覆盖。
defaults:
  user: [[.User]]
