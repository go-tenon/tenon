# 独立生产配置模板：未显式填写的超时、健康探针过滤等由框架默认值补全。
# 同目录存在本文件时，tenon deploy 会以 0640 权限同步到远端并自动传入 --config。
http:
  addr: "127.0.0.1:8080"                # 仅监听本机回环，由同机 Nginx/Caddy 反向代理转发
  public_url: "https://example.com"     # 对外访问地址
  client_ip:
    trusted_proxies:
      - "127.0.0.1/32"                  # 同机反向代理网段，用于还原客户端真实 IP
  access_log:
    disabled: true                      # 反向代理已记录访问日志时关闭应用访问日志

logs:
  level: info

telemetry:
  service: [[.Slug]]
  # endpoint: https://o2.example.com/api/default
