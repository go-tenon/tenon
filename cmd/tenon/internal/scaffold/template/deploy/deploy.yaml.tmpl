# 原生二进制 + systemd 部署配置：运行 go tool tenon deploy setup 初始化目标机，再运行 go tool tenon deploy 发布
app: [[.Slug]]
# 目标 Linux 架构（amd64、arm64）；留空时通过 SSH 自动探测
# arch: amd64
keep_releases: 5

environments:
  production:
    user: [[.User]]              # SSH 登录用户（需具备 sudo 权限）
    service_user: [[.Slug]]      # 运行应用的 Linux 系统用户
    dir: /opt/[[.Slug]]          # 远端部署目录
    env_file: /etc/[[.Slug]]/env # 远端环境变量文件（600 权限，不进仓库）
    config_dir: config           # 同步到远端的配置目录（自动排除 local.yaml），与 config_files 互斥
    # 按环境叠加多个本地配置文件时，删除上面的 config_dir 并改用 config_files（精确打包为 0640 权限并自动传入 --config）：
    # config_files:
    #   - config/app.yaml
    #   - config/prod.yaml
    # 单机最简写法（在一个进程中运行全部部分 all）：
    hosts:
      - [[.Host]]
    # 多服务多机写法（把上面的 hosts 换成 roles，同一台主机可同时出现在多个角色下）：
    # migrate_host: 10.0.1.21
    # roles:
    #   http:
    #     hosts: [10.0.1.11, 10.0.1.12]
    #     max_parallel: 1
    #     stop_timeout: 30s
    #   worker:
    #     hosts: [10.0.1.21]
    #     stop_timeout: 120s
    #   scheduler:
    #     hosts: [10.0.1.21]
    # 可选：维护页标记文件路径，配合反向代理返回 503
    # maintenance_file: /etc/nginx/[[.Slug]].maintenance
