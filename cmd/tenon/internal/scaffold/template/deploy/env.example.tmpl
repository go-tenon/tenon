# 生产环境变量模板：复制为 .env.production 填写后，运行 go tool tenon deploy env push .env.production 上传
# 外部访问地址（生产环境经反向代理启用 HTTPS，登录 Cookie 带有 __Host- 与 Secure）
APP_URL=https://example.com
# 应用密钥，执行 openssl rand -base64 32 生成；生成后保持固定
APP_KEY=
# 数据库连接串
DATABASE_URL=postgres://[[.Slug]]:change-me@127.0.0.1:5432/[[.Slug]]?sslmode=disable
# NATS JetStream 地址
NATS_URL=nats://127.0.0.1:4222
# 日志级别：debug、info、warn、error
LOG_LEVEL=info
# 可选：OpenObserve / OpenTelemetry OTLP 接收端与认证（留空时不推送；也直接在 config/prod.yaml 的 telemetry 段填写）
# OTLP_ENDPOINT=https://o2.example.com/api/default
# OTLP_TOKEN=<base64(user:password)>
# O2_SITE=https://o2.example.com
# O2_CLIENT_TOKEN=<openobserve-rum-client-token>
