# 生产环境变量模板：复制为 .env 后填写
APP_VERSION=latest
HTTP_PORT=8080
# 外部访问地址（生产环境需经反向代理启用 HTTPS，登录 Cookie 带有 __Host- 与 Secure）
APP_URL=https://example.com
# 应用密钥，执行 openssl rand -base64 32 生成；生成后保持固定
APP_KEY=
# 数据库密码，执行 openssl rand -hex 24 生成
POSTGRES_PASSWORD=
# 日志级别：debug、info、warn、error
LOG_LEVEL=info
# 可选：OpenTelemetry OTLP 接收端基础地址，例如 http://openobserve:5080/api/default
OTLP_ENDPOINT=
