# 生产自托管编排：cp .env.example .env 填写后执行 docker compose -f compose.prod.yaml up -d
x-app: &app
  image: [[.Image]]:${APP_VERSION:-latest}
  build: .
  environment:
    APP_URL: ${APP_URL}
    APP_KEY: ${APP_KEY}
    DATABASE_URL: postgres://[[.Slug]]:${POSTGRES_PASSWORD}@postgres:5432/[[.Slug]]?sslmode=disable
    NATS_URL: nats://nats:4222
    LOG_LEVEL: ${LOG_LEVEL:-info}
    OTLP_ENDPOINT: ${OTLP_ENDPOINT:-}
  depends_on:
    postgres:
      condition: service_healthy
    nats:
      condition: service_healthy

services:
  migrate:
    <<: *app
    command: [migrate, up]

  app:
    <<: *app
    command: [serve]
    ports: ["${HTTP_PORT:-8080}:8080"]
    healthcheck:
      test: [CMD, /app/[[.Slug]], health]
      interval: 10s
      timeout: 5s
      retries: 3
    restart: unless-stopped
    stop_grace_period: 45s
    depends_on:
      migrate:
        condition: service_completed_successfully

  postgres:
    image: postgres:18
    command:
      - postgres
      - -c
      - wal_level=logical
      - -c
      - max_slot_wal_keep_size=10GB
      - -c
      - wal_sender_timeout=10s
    environment:
      POSTGRES_USER: [[.Slug]]
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
    volumes: [postgres:/var/lib/postgresql]
    restart: unless-stopped
    healthcheck:
      test: [CMD, pg_isready, -U, [[.Slug]], -h, 127.0.0.1]
      interval: 2s
      retries: 30

  nats:
    image: nats:2.15-alpine
    command: [nats-server, -js, -sd, /data, -m, "8222"]
    volumes: [nats:/data]
    restart: unless-stopped
    healthcheck:
      test: [CMD, wget, -qO-, "http://127.0.0.1:8222/healthz?js-enabled-only=true"]
      interval: 2s
      retries: 30

volumes:
  postgres:
  nats:
