{
  "$schema": "../../node_modules/@biomejs/biome/configuration_schema.json",
  "files": { "includes": ["src/**", "!src/routeTree.gen.ts"] },
  "linter": {
    "rules": {
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["@radix-ui/*", "lucide-react", "class-variance-authority", "tailwind-merge", "tailwindcss", "@tailwindcss/*", "@/components/ui/*"],
                "message": "运营后台用 antd 和 ProComponents，不用 shadcn、Radix 和 Tailwind，见 AGENTS.md。"
              }
            ]
          }
        }
      }
    }
  }
}
