import { NotFoundPage, RouteError } from "@go-tenon/admin"
import { createApp } from "@go-tenon/shell"
import { me, session } from "./auth"
import { routeTree } from "./routeTree.gen"

// app 装配路由、TanStack Query 和会话，见框架文档的“应用骨架”。
export const app = createApp({
  id: "[[.Name]]",
  routeTree,
  session,
  permissions: async () => (await me()).permissions ?? [],
  router: { defaultErrorComponent: RouteError, defaultNotFoundComponent: NotFoundPage },
})

declare module "@tanstack/react-router" {
  interface Register {
    router: typeof app.router
  }
}
