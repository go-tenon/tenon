import { createRootRouteWithContext, Outlet } from "@tanstack/react-router"
import { AdminProvider, NewVersionNotice } from "@go-tenon/admin"
import type { RouterContext } from "@go-tenon/shell"
import { antd } from "@[[.Scope]]/theme"

// 根路由：antd 的全局配置（品牌色和圆角来自设计令牌 theme/tokens.json）和新版本提示。
export const Route = createRootRouteWithContext<RouterContext>()({ component: Root })

function Root() {
  return (
    <AdminProvider tokens={antd}>
      <NewVersionNotice />
      <Outlet />
    </AdminProvider>
  )
}
