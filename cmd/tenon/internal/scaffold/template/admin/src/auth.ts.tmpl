import { createSession, ensureOK, type SessionBody } from "@go-tenon/client"

// 登录相关的接口。模板按框架约定的路径调用它们，应用在 /api 下注册（写法见教程第 6 章“登录”和
// “单页应用的登录”）：POST /api/auth/login、/api/auth/refresh、/api/auth/logout，GET /api/me。
// 接口名或路径不同时只改这个文件。

async function post(path: string, body?: unknown): Promise<unknown> {
  const res = await fetch(`/api${path}`, {
    method: "POST",
    credentials: "same-origin",
    headers: body === undefined ? undefined : { "Content-Type": "application/json" },
    body: body === undefined ? undefined : JSON.stringify(body),
  })
  return (await ensureOK(res)).json()
}

// session 保管登录凭据：access token 只放在内存中，refresh token 在 HttpOnly cookie 中。
export const session = createSession({ refresh: () => post("/auth/refresh") as Promise<SessionBody> })

// 带上 access token、401 时刷新再重试的 fetch。
const authed = session.fetch(fetch)

export const login = (values: { email: string; password: string }) => post("/auth/login", values) as Promise<SessionBody>

export const logout = async () => ensureOK(await authed("/api/auth/logout", { method: "POST" }))

/** 当前登录的用户：显示名称；permissions 是可选的，用于菜单和按钮的权限。 */
export interface Me {
  name: string
  permissions?: string[]
}

export async function me(): Promise<Me> {
  return (await (await ensureOK(await authed("/api/me"))).json()) as Me
}
