import { useQuery } from "@tanstack/react-query"
import { createFileRoute } from "@tanstack/react-router"
import { Fill, requireAuth, type TabsOutletProps, useLayoutVariant } from "@go-tenon/shell"
import { CommandMenu } from "@/components/tenon/command-menu"
import { useConfirm } from "@/components/tenon/dialogs"
import { MixedLayout } from "@/components/tenon/mixed-layout"
import { CenteredLayout } from "@/components/tenon/page-layouts"
import { RailLayout } from "@/components/tenon/rail-layout"
import { SidebarLayout } from "@/components/tenon/sidebar-layout"
import { TenantSwitcher } from "@/components/tenon/tenant-switcher"
import { TopNavLayout } from "@/components/tenon/topnav-layout"
import { UserMenu } from "@/components/tenon/user-menu"
import { logout, me } from "../auth"
import { layouts } from "../layouts"

// 需要登录的页面都在 _app 之下：没有登录时跳到登录页，登录后回来。
export const Route = createFileRoute("/_app")({ beforeLoad: requireAuth, component: Layout })

function Layout() {
  const user = useQuery({ queryKey: ["me"], queryFn: me })
  const confirm = useConfirm()
  // 当前的布局：用户在布局页面中选过的，否则是 layouts 的第一种。
  const [layout] = useLayoutVariant(layouts)
  // 多标签；关闭有未保存修改的标签时用 confirm 询问。
  const tabs: TabsOutletProps = { confirm: (message) => confirm(message) }
  return (
    <>
      <Fill name="user">
        <UserMenu name={user.data?.name} logout={logout} />
      </Fill>
      <Fill name="search">
        <CommandMenu />
      </Fill>
      <Fill name="tenant">
        <TenantSwitcher />
      </Fill>
      {layout === "top" ? (
        <TopNavLayout title="[[.Title]]" tabs={tabs} />
      ) : layout === "mix" ? (
        <MixedLayout title="[[.Title]]" tabs={tabs} />
      ) : layout === "rail" ? (
        <RailLayout tabs={tabs} />
      ) : layout === "centered" ? (
        <CenteredLayout title="[[.Title]]" />
      ) : (
        <SidebarLayout title="[[.Title]]" variant={layout === "side" ? "sidebar" : layout} tabs={tabs} />
      )}
    </>
  )
}
