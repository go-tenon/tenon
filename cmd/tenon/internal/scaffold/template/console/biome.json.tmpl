{
  "$schema": "../../node_modules/@biomejs/biome/configuration_schema.json",
  "files": { "includes": ["src/**", "!src/routeTree.gen.ts", "!src/components/ui", "!src/hooks", "!src/lib"] },
  "css": { "parser": { "tailwindDirectives": true } },
  "linter": {
    "rules": {
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["antd", "antd/*", "@ant-design/*"],
                "message": "这个前端用 shadcn 和 Tailwind，不用 antd，见 AGENTS.md。"
              }
            ]
          }
        }
      }
    }
  }
}
