# electron-builder 的配置，见 https://www.electron.build/configuration。
# go tool tenon build --client [[.Name]] 先把前端构建到 dist/renderer、把主进程和 preload 打包到 dist，再运行它。
appId: com.[[.Scope]].[[.Name]]
productName: [[.Title]]
executableName: [[.Name]] # 默认取 package.json 的 name，带作用域的包名不能作为文件名
directories:
  output: release
files:
  - dist/**/*
  - assets/**/*
  - package.json
# 应用图标：build/icon.png（至少 512×512），换成应用自己的。
asar: true
# Electron 的安全开关（fuses）：不能当作 Node 运行，只从 app.asar 加载代码并校验它的完整性。
electronFuses:
  runAsNode: false
  enableCookieEncryption: true
  enableNodeOptionsEnvironmentVariable: false
  enableNodeCliInspectArguments: false
  enableEmbeddedAsarIntegrityValidation: true
  onlyLoadAppFromAsar: true
# 深度链接：[[.Name]]://open/<路径> 打开应用中的页面，路径与网页上的相同。
protocols:
  - name: [[.Title]]
    schemes:
      - [[.Name]]
# 自动更新的来源：把 release 中的安装包和 latest*.yml 放到这个地址，见 @go-tenon/electron/update。
publish:
  provider: generic
  url: https://example.com/downloads/[[.Name]]
mac:
  target: [dmg, zip] # zip 用于自动更新
  category: public.app-category.productivity
win:
  target: nsis
linux:
  target: AppImage
  category: Utility
  syncDesktopName: true # 窗口与 .desktop 文件关联（package.json 的 desktopName）
