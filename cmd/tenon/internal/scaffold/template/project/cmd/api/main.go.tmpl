// Command api 是[[.Name]]的入口：serve 启动 HTTP 服务，openapi、routes、client 供 go tool tenon 生成文档和客户端。
package main

import (
	"context"
	"log/slog"
	"net/http"

	"github.com/go-chi/chi/v5"

	"github.com/go-tenon/tenon/command"
	"github.com/go-tenon/tenon/command/httpcmd"
	"github.com/go-tenon/tenon/config"
	"github.com/go-tenon/tenon/httpx"
	"github.com/go-tenon/tenon/httpx/rest"
	"github.com/go-tenon/tenon/logging"
	"github.com/go-tenon/tenon/ssr"

	"[[.Module]]/apps/web"
	"[[.Module]]/internal/todo"
)

// Config 是应用的配置：config/app.yaml。
type Config struct {
	HTTP httpx.Config `yaml:"http"`
	// DevServers 是各前端开发服务器的地址，按前端的名称（apps 中的目录名）。只在 tenon dev 时有值：
	// 它把地址写入 .tenon/dev.yaml，页面请求转给对应的开发服务器。
	DevServers map[string]string `yaml:"dev_servers"`
}

func main() {
	root := command.Root("api", "[[.Name]]")
	root.AddCommand(
		command.Run("serve", "启动 HTTP 服务", serve),
		command.Config[Config](),
	)
	// openapi、routes、client 用默认配置和 nil 依赖构造同一套路由，从中读取路由表和接口定义。
	root.AddCommand(httpcmd.Commands(func() chi.Routes { return routes(config.Default[Config](), nil, pages{}) })...)
	command.Execute(root)
}

// pages 是各前端的页面处理器，挂在接口之后。
type pages struct{ web http.Handler }

// serve 启动 HTTP 服务，直到收到停止信号。页面由 Go 托管的 SSR 进程渲染（见 ssr 包），
// 它们渲染时经内部 socket 调用同一组路由。
func serve(ctx context.Context, cfg Config) error {
	slog.SetDefault(logging.New(logging.Config{}))
	var router chi.Router
	api := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { router.ServeHTTP(w, r) })
	webPages, err := ssr.New(ssr.Options{Executable: web.SSR, API: api, DevServer: cfg.DevServers["web"]})
	if err != nil {
		return err
	}
	router = routes(cfg, todo.NewStore(), pages{web: webPages.Handler()})
	return ssr.Run(ctx, func(ctx context.Context) error {
		return httpx.ListenAndServe(ctx, cfg.HTTP, router)
	}, webPages)
}

// routes 是应用的全部路由：/api 下是接口，其余路径是页面。
// 它只保存依赖，处理请求时才使用，所以 openapi 等命令可以传 nil。
func routes(cfg Config, store *todo.Store, p pages) chi.Router {
	router := chi.NewRouter()
	router.Use(httpx.Defaults(cfg.HTTP)...)
	router.Route("/api", func(r chi.Router) {
		r.Use(httpx.Timeout(cfg.HTTP.Timeout))
		api := rest.New(r, rest.Options{Title: "[[.Name]]", Version: "0.1.0", BasePath: "/api"})
		todo.Register(api, store)
	})
	if p.web != nil {
		router.Handle("/*", p.web)
	}
	return router
}
