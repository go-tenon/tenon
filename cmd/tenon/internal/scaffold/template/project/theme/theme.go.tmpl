// Package theme 是[[.Name]]的设计令牌 tokens.json，嵌入程序。服务端渲染的页面这样使用它：
//
//	web.New(web.Options{Theme: cfg.Theme.WithTokens(theme.Tokens)})
//
// 前端的主题包 packages/theme 由 go tool tenon generate 从同一份令牌生成。
package theme

import (
	_ "embed"

	tokens "github.com/go-tenon/tenon/theme"
)

//go:embed tokens.json
var data []byte

// Tokens 是解析后的设计令牌。
var Tokens = tokens.MustParse(data)
