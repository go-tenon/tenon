/* 设计令牌（theme/tokens.json）生成的 CSS 变量：--primary、--radius 等。修改品牌色后页面随之改变。 */
@import "@[[.Slug]]/theme/tokens.css";

body {
  margin: 0;
  font-family: var(--font-sans, system-ui, sans-serif);
  background: #f6f6f6;
}

h1 {
  color: var(--primary);
}

button {
  padding: 0.4rem 0.8rem;
  border: 0;
  border-radius: var(--radius);
  background: var(--primary);
  color: var(--primary-foreground);
  cursor: pointer;
}

main {
  max-width: 32rem;
  margin: 3rem auto;
  padding: 1.5rem;
  background: #fff;
  border-radius: calc(var(--radius) * 1.5);
}

form {
  display: flex;
  gap: 0.5rem;
}

input[type="text"],
form input {
  flex: 1;
  padding: 0.5rem;
}

ul {
  list-style: none;
  padding: 0;
}

li {
  display: flex;
  justify-content: space-between;
  padding: 0.5rem 0;
  border-bottom: 1px solid #eee;
}

li.done label {
  color: #999;
  text-decoration: line-through;
}

.error {
  color: #c00;
}
