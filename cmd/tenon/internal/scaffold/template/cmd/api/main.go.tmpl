// Command api 是[[.Name]]的入口：serve 启动 HTTP 服务，openapi、routes、client 供 go tool tenon 生成文档和客户端。
package main

import (
	"context"
	"log/slog"

	"github.com/go-chi/chi/v5"

	"github.com/go-tenon/tenon/command"
	"github.com/go-tenon/tenon/command/httpcmd"
	"github.com/go-tenon/tenon/config"
	"github.com/go-tenon/tenon/httpx"
	"github.com/go-tenon/tenon/httpx/rest"
	"github.com/go-tenon/tenon/logging"

	"[[.Module]]/frontend"
	"[[.Module]]/internal/todo"
)

// Config 是应用的配置：config/app.yaml，开发时再叠加 config/local.yaml。
type Config struct {
	HTTP httpx.Config `yaml:"http"`
	// FrontendDevServer 非空时把页面请求转给 Vite 的开发服务器，只在 config/local.yaml 中设置。
	FrontendDevServer string `yaml:"frontend_dev_server"`
}

func main() {
	root := command.Root("api", "[[.Name]]")
	root.AddCommand(
		command.Run("serve", "启动 HTTP 服务", serve),
		command.Config[Config](),
	)
	// openapi、routes、client 用默认配置和 nil 依赖构造同一套路由，只读取它，不启动服务。
	root.AddCommand(httpcmd.Commands(func() chi.Routes { return routes(config.Default[Config](), nil) })...)
	command.Execute(root)
}

// serve 启动 HTTP 服务，直到收到停止信号。
func serve(ctx context.Context, cfg Config) error {
	slog.SetDefault(logging.New(logging.Config{}))
	return httpx.ListenAndServe(ctx, cfg.HTTP, routes(cfg, todo.NewStore()))
}

// routes 是应用的全部路由：/api 下是接口，其余路径交给单页应用。
// 它只保存依赖、不调用依赖，所以 openapi 等命令可以传 nil。
func routes(cfg Config, store *todo.Store) chi.Router {
	router := chi.NewRouter()
	router.Use(httpx.Defaults(cfg.HTTP)...)
	router.Route("/api", func(r chi.Router) {
		r.Use(httpx.Timeout(cfg.HTTP.Timeout))
		api := rest.New(r, rest.Options{Title: "[[.Name]]", Version: "0.1.0", BasePath: "/api"})
		todo.Register(api, store)
	})
	router.Handle("/*", httpx.NewSPA(frontend.Dist, httpx.SPAOptions{DevServer: cfg.FrontendDevServer}))
	return router
}
