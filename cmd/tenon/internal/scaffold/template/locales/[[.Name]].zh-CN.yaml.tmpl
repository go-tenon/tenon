# 前端 [[.Name]] 的界面文字（简体中文）。tenon generate 把它生成为 apps/[[.Name]]/src/messages.gen.ts，页面用 useT 取出。
# 加一种语言就加一个文件，例如 [[.Name]].en.yaml，见框架文档的“界面文字”。
app.[[.Name]]: [[printf "%q" .Title]]
[[- if eq .Layout "site"]]
[[- if .HasLogin]]
home.login: 登录
[[- else]]
home.get_started: 开始使用
[[- end]]
home.placeholder: 这里是首页的占位，换成自己的落地页。
[[- else]]
home.title: 首页
home.start: 从这里开始。
[[- end]]
[[- if .HasLogin]]
signin.title: 登录
[[- end]]
