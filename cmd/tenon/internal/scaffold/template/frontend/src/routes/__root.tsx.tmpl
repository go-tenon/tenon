[[if eq .Style "site"]]import "@fontsource-variable/inter/index.css"
[[end]]import "@go-tenon/ui/styles.css"
import type { ReactNode } from "react"
import { mantineHtmlProps } from "@mantine/core"
import { createRootRouteWithContext, HeadContent, Outlet, Scripts } from "@tanstack/react-router"
import { ColorSchemeScript, type RouterContext, UIProvider } from "@go-tenon/ui"
import { theme } from "../theme"

// 根路由：整个 HTML 文档。页面在 <Outlet /> 中。
export const Route = createRootRouteWithContext<RouterContext>()({
  head: () => ({
    meta: [{ charSet: "utf-8" }, { name: "viewport", content: "width=device-width, initial-scale=1" }, { title: "[[.Title]]" }],
  }),
  shellComponent: Document,
  component: Outlet,
})

function Document({ children }: { children: ReactNode }) {
  // ColorSchemeScript 在页面显示之前设置配色；它带上 Go 为每个请求生成的 nonce，通过内容安全策略。
  return (
    <html lang="zh-CN" {...mantineHtmlProps}>
      <head>
        <ColorSchemeScript[[if eq .Landing "dusk"]] defaultColorScheme="dark"[[end]] />
        <HeadContent />
      </head>
      <body>
        <UIProvider theme={theme}[[if eq .Landing "dusk"]] defaultColorScheme="dark"[[end]]>{children}</UIProvider>
        <Scripts />
      </body>
    </html>
  )
}
