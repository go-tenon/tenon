import { createUiTheme } from "@go-tenon/ui"

[[- if eq .Style "site"]]

// 主题：样式预设、落地页的风格（classic、dusk、ink、mist）和品牌色。改品牌色、换风格只改这里。
// 品牌色写预设的名称（primaryColors，例如 sky-blue）或者颜色值。
export const theme = createUiTheme({ preset: "site", landing: "[[.Landing]]", primary: "#4f5bd5" })
[[- else]]

// 主题：样式预设加上品牌色和圆角。改品牌色只改这里。
// 品牌色写预设的名称（primaryColors，例如 sky-blue）或者颜色值。
export const theme = createUiTheme({ preset: "[[.Style]]", primary: "[[if eq .Style "admin"]]pale-blue[[else]]#4f5bd5[[end]]" })
[[- end]]
