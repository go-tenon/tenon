import { ensureOK } from "@go-tenon/client"
import { CenteredAuthLayout, requireAuth } from "@go-tenon/ui"
import { Alert, Button, Group, List, Stack, Text } from "@mantine/core"
import { useMutation, useQuery } from "@tanstack/react-query"
import { createFileRoute } from "@tanstack/react-router"
import { session } from "../../auth"

// 授权页：授权服务器（oauthserver）的 ConsentURL 指向这里，即 [[.Base]]oauth/consent。
// 桌面端、App 在浏览器中登录时（应用自己的客户端），用户在这里确认登录；第三方应用申请访问时，这里列出申请的范围。
// 接口由 oauthserver 的 Register 注册在 /api 下。

/** 授权请求，来自 GET /api/oauth/consent。 */
interface Consent {
  client_name: string
  redirect_host: string
  first_party: boolean
  scopes: { name: string; description: string }[]
}

async function send(method: string, path: string, body?: unknown): Promise<unknown> {
  const res = await session.fetch(fetch)(`/api/oauth/consent${path}`, {
    method,
    headers: body === undefined ? undefined : { "Content-Type": "application/json" },
    body: body === undefined ? undefined : JSON.stringify(body),
  })
  return (await ensureOK(res)).json()
}

export const Route = createFileRoute("/oauth/consent")({
  validateSearch: (s: Record<string, unknown>) => ({
    request: typeof s.request === "string" ? s.request : "",
    error: typeof s.error === "string" ? s.error : "",
  }),
  [[if .SSR]]ssr: false,
  [[end]]beforeLoad: requireAuth,
  component: ConsentPage,
})

function ConsentPage() {
  const { request, error } = Route.useSearch()
  const consent = useQuery({
    queryKey: ["oauth-consent", request],
    enabled: request !== "",
    queryFn: () => send("GET", `?request=${encodeURIComponent(request)}`) as Promise<Consent>,
  })
  const decide = useMutation({
    mutationFn: async (approve: boolean) => {
      const { url } = (await send("POST", "", { request, approve })) as { url: string }
      location.assign(url) // 回到客户端：整页跳转
    },
  })
  const c = consent.data
  return (
    <CenteredAuthLayout brand="[[.Title]]" title={c?.first_party ? `在${c.client_name}上登录` : "授权"}>
      {error || consent.error ? (
        <Alert color="red" variant="light">
          无法授权（{error || "请求无效或已过期"}）。
        </Alert>
      ) : !c ? null : c.first_party ? (
        <Stack gap="md">
          <Text size="sm" c="dimmed">
            确认后回到{c.client_name}。
          </Text>
          <Button loading={decide.isPending} onClick={() => decide.mutate(true)} fullWidth>
            继续
          </Button>
        </Stack>
      ) : (
        <Stack gap="md">
          <Text size="sm">{c.client_name} 请求访问你的账号：</Text>
          <List size="sm">
            {c.scopes.map((s) => (
              <List.Item key={s.name}>{s.description}</List.Item>
            ))}
          </List>
          <Text size="xs" c="dimmed">
            授权后将跳转到 {c.redirect_host}
          </Text>
          <Group grow>
            <Button variant="default" disabled={decide.isPending} onClick={() => decide.mutate(false)}>
              拒绝
            </Button>
            <Button loading={decide.isPending} onClick={() => decide.mutate(true)}>
              允许
            </Button>
          </Group>
        </Stack>
      )}
    </CenteredAuthLayout>
  )
}
