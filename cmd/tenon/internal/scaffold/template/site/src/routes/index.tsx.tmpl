import { Button, Container, Stack, Text, Title } from "@mantine/core"
import { createFileRoute } from "@tanstack/react-router"
import { SiteLayout } from "@go-tenon/ui"

// 首页在构建时预渲染（vite.config.ts 的 prerender），其余页面在请求时服务端渲染。
// 这是首页的占位：页头用 SiteLayout，内容换成自己的落地页；文档页用 DocsLayout，见框架文档的“官网与文档站”。
export const Route = createFileRoute("/")({ component: Home })

function Home() {
  return (
    <SiteLayout brand="[[.Title]]" actions={<Button size="sm">开始使用</Button>}>
      <Container size="sm" py={96}>
        <Stack gap="md" align="flex-start">
          <Title order={1}>[[.Title]]</Title>
          <Text c="dimmed">这里是首页的占位，换成自己的落地页。</Text>
        </Stack>
      </Container>
    </SiteLayout>
  )
}
