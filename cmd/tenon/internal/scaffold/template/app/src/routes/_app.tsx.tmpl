[[if .HasLogin -]]
import { useQuery } from "@tanstack/react-query"
[[end -]]
import { createFileRoute } from "@tanstack/react-router"
import { [[if eq .Layout "frame"]]FrameLayout[[else]]RailLayout[[end]][[if .HasLogin]], requireAuth, UserMenu[[end]] } from "@go-tenon/ui"
[[- if .HasLogin]]
import { logout, me } from "../auth"
[[- end]]

[[- if .HasLogin]]

// 需要登录的页面都在 _app 之下：没有登录时跳到登录页，登录后回来。[[if .SSR]]这些页面只在浏览器中渲染（ssr: false）。[[end]]
export const Route = createFileRoute("/_app")({ [[if .SSR]]ssr: false, [[end]]beforeLoad: requireAuth, component: Layout })
[[- else]]

// 页面都在 _app 之下，共用一个布局。
export const Route = createFileRoute("/_app")({ component: Layout })
[[- end]]

function Layout() {
[[- if .HasLogin]]
  const user = useQuery({ queryKey: ["me"], queryFn: me })
[[- end]]
[[- if eq .Layout "frame"]]
  // 每个页面都有的部分是 FrameLayout 的参数；某个页面才有的按钮，由页面用 <Fill name="actions"> 放进顶栏。
  // tabs 开启多标签。
  return <FrameLayout title="[[.Title]]" tabs[[if .HasLogin]] user={<UserMenu name={user.data?.name} logout={logout} />}[[end]] />
[[- else]]
  // RailLayout：双栏导航（模块的图标栏和二级导航）[[if .HasLogin]]，设置从用户菜单进入[[end]]。
  return <RailLayout title="[[.Title]]"[[if .HasLogin]] user={<UserMenu name={user.data?.name} position="right-end" logout={logout} />}[[end]] />
[[- end]]
}
