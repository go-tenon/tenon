import { useQuery } from "@tanstack/react-query"
import { createFileRoute } from "@tanstack/react-router"
import { [[if eq .Style "admin"]]AppLayout[[else]]ConsoleSideLayout[[end]], requireAuth, UserMenu } from "@go-tenon/ui"
import { logout, me } from "../auth"

// 需要登录的页面都在 _app 之下：没有登录时跳到登录页，登录后回来。
export const Route = createFileRoute("/_app")({ beforeLoad: requireAuth, component: Layout })

function Layout() {
  const user = useQuery({ queryKey: ["me"], queryFn: me })
[[- if eq .Style "admin"]]
  // 每个页面都有的部分是 AppLayout 的参数；某个页面才有的按钮，由页面用 <Fill name="actions"> 放进顶栏。
  // tabs 开启多标签。
  return <AppLayout title="[[.Title]]" tabs user={<UserMenu name={user.data?.name} logout={logout} />} />
[[- else]]
  // 商户侧的布局（占位）：侧栏导航；ConsoleTopLayout 是顶部导航。
  return <ConsoleSideLayout title="[[.Title]]" user={<UserMenu name={user.data?.name} logout={logout} />} />
[[- end]]
}
