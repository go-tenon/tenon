import { useQuery } from "@tanstack/react-query"
import { createFileRoute } from "@tanstack/react-router"
import { [[if eq .Style "admin"]]AdminLayout[[else]]RailLayout[[end]], requireAuth, UserMenu } from "@go-tenon/ui"
import { logout, me } from "../auth"

// 需要登录的页面都在 _app 之下：没有登录时跳到登录页，登录后回来。
export const Route = createFileRoute("/_app")({ beforeLoad: requireAuth, component: Layout })

function Layout() {
  const user = useQuery({ queryKey: ["me"], queryFn: me })
[[- if eq .Style "admin"]]
  // 每个页面都有的部分是 AdminLayout 的参数；某个页面才有的按钮，由页面用 <Fill name="actions"> 放进顶栏。
  // tabs 开启多标签。
  return <AdminLayout title="[[.Title]]" tabs user={<UserMenu name={user.data?.name} logout={logout} />} />
[[- else]]
  // console 的布局 Rail：双栏导航（模块的图标栏和二级导航），设置从用户菜单进入。
  return <RailLayout title="[[.Title]]" user={<UserMenu name={user.data?.name} position="right-end" logout={logout} />} />
[[- end]]
}
