import { Text } from "@mantine/core"
import { createFileRoute } from "@tanstack/react-router"
import { Page, useT } from "@go-tenon/ui"

// 首页。页面放在 src/routes/_app/ 中，staticData 的 title、icon、order 决定菜单；title 写界面文字的消息 ID。
export const Route = createFileRoute("/_app/")({
  staticData: { title: "home.title", icon: "home", order: 0 },
  component: Home,
})

function Home() {
  const t = useT()
  return (
    <Page title={t("home.title")}>
      <Text c="dimmed">{t("home.start")}</Text>
    </Page>
  )
}
