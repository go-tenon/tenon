package pages

import (
	"github.com/ryan053857/go-kit/modules/notification"
	"github.com/ryan053857/go-kit/examples/starter/components/button"
	"github.com/ryan053857/go-kit/examples/starter/components/card"
)

templ notificationsPage(list []notification.Notification) {
	<div class="flex flex-col gap-6">
		<div class="flex items-center">
			<h1 class="text-2xl font-semibold">通知</h1>
			<form method="post" action="/notifications/read-all" class="ml-auto">
				@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline, Size: button.SizeSm}) {
					全部标记已读
				}
			</form>
		</div>
		@card.Card(card.Props{Class: "py-0"}) {
			@card.Content(card.ContentProps{Class: "flex flex-col divide-y px-0"}) {
				if len(list) == 0 {
					<p class="text-muted-foreground p-6 text-center text-sm">暂无通知</p>
				}
				for _, n := range list {
					<a href={ templ.SafeURL("/notifications/" + n.ID.String()) } class="hover:bg-muted/50 flex items-start gap-3 px-6 py-4">
						if n.Read() {
							<span class="mt-1.5 size-2 shrink-0"></span>
						} else {
							<span class="bg-primary mt-1.5 size-2 shrink-0 rounded-full"></span>
						}
						<div class="flex-1">
							<p class={ "text-sm", templ.KV("font-medium", !n.Read()), templ.KV("text-muted-foreground", n.Read()) }>{ n.Title }</p>
							if n.Body != "" {
								<p class="text-muted-foreground mt-1 text-sm">{ n.Body }</p>
							}
						</div>
						<span class="text-muted-foreground text-xs">{ fmtTime(n.CreatedAt) }</span>
					</a>
				}
			}
		}
	</div>
}
