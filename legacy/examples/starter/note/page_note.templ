package note

import (
	"time"

	"github.com/ryan053857/go-kit/examples/starter/components/button"
	"github.com/ryan053857/go-kit/examples/starter/components/card"
)

templ noteDetail(n *Note) {
	@card.Card() {
		@card.Header() {
			@card.Title() {
				{ n.Text }
			}
			@card.Description() {
				{ n.CreatedAt.In(time.Local).Format("2006-01-02 15:04") }
			}
		}
		@card.Footer() {
			@button.Button(button.Props{Href: "/", Variant: button.VariantOutline}) {
				返回列表
			}
		}
	}
}
